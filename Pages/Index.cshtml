@page
@model IndexModel
@{
    ViewData["Title"] = "Leads";
}

<h1>Leads</h1>

<nav class="pipeline" aria-label="Filter by stage">
    <a class="stage @(Model.Stage is null ? "active" : "")" asp-page="Index" asp-route-q="@Model.Q">
        <span class="stage-top"><span>All</span><span class="stage-count">@Model.Total</span></span>
        <span class="stage-track"><span class="stage-fill" style="width:100%"></span></span>
    </a>
    @foreach (var stage in Enum.GetValues<LeadStage>())
    {
        var count = Model.Counts.TryGetValue(stage, out var c) ? c : 0;
        var pct = Model.Total == 0 ? 0 : count * 100 / Model.Total;
        <a class="stage @(Model.Stage == stage ? "active" : "")" data-stage="@stage"
           asp-page="Index" asp-route-stage="@stage" asp-route-q="@Model.Q">
            <span class="stage-top"><span>@stage</span><span class="stage-count">@count</span></span>
            <span class="stage-track"><span class="stage-fill" style="width:@(pct)%"></span></span>
        </a>
    }
</nav>

<form method="get" class="toolbar" role="search">
    <input type="hidden" name="stage" value="@Model.Stage" />
    <input type="search" name="q" value="@Model.Q" placeholder="Search by name, company or email" aria-label="Search leads" />
    <button type="submit" class="btn btn-quiet">Search</button>
    @if (!string.IsNullOrWhiteSpace(Model.Q) || Model.Stage is not null)
    {
        <a class="btn btn-quiet" asp-page="Index">Clear filters</a>
    }
</form>

@if (Model.Leads.Count == 0)
{
    <div class="empty">
        <h2>No leads found</h2>
        <p>@(Model.Total == 0 ? "Add your first lead to start the pipeline." : "Try a different search or stage.")</p>
        <a class="btn btn-primary" asp-page="Create">Add lead</a>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="leads">
            <thead>
                <tr>
                    <th>Lead</th>
                    <th>Contact</th>
                    <th>Stage</th>
                    <th class="num">Value</th>
                    <th>Updated</th>
                    <th><span class="sr-only">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lead in Model.Leads)
                {
                    <tr>
                        <td>
                            <a class="lead-name" asp-page="Details" asp-route-id="@lead.Id">@lead.Name</a>
                            <div class="sub">@lead.Company</div>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(lead.Email))
                            {
                                <a href="mailto:@lead.Email">@lead.Email</a>
                            }
                            <div class="sub">@lead.Phone</div>
                        </td>
                        <td><span class="badge" data-stage="@lead.Stage">@lead.Stage</span></td>
                        <td class="num">@lead.FormattedValue</td>
                        <td class="sub">@lead.UpdatedUtc.ToString("dd MMM yyyy")</td>
                        <td class="actions">
                            <a class="btn btn-quiet btn-sm" asp-page="Edit" asp-route-id="@lead.Id">Edit</a>
                            <button type="button" class="btn btn-quiet btn-sm" data-delete data-id="@lead.Id" data-name="@lead.Name">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<dialog id="confirmDelete" class="dialog" aria-labelledby="deleteTitle">
    <form method="post" asp-page-handler="Delete" asp-route-q="@Model.Q" asp-route-stage="@Model.Stage">
        <input type="hidden" name="id" id="deleteId" />
        <h2 id="deleteTitle">Delete lead?</h2>
        <p><strong id="deleteName"></strong> will be removed. This cannot be undone.</p>
        <div class="dialog-actions">
            <button type="button" class="btn btn-quiet" data-close>Cancel</button>
            <button type="submit" class="btn btn-danger">Delete lead</button>
        </div>
    </form>
</dialog>

@section Scripts {
    <script>
        (function () {
            var dialog = document.getElementById('confirmDelete');
            document.querySelectorAll('[data-delete]').forEach(function (button) {
                button.addEventListener('click', function () {
                    document.getElementById('deleteId').value = button.dataset.id;
                    document.getElementById('deleteName').textContent = button.dataset.name;
                    dialog.showModal();
                });
            });
            dialog.querySelector('[data-close]').addEventListener('click', function () { dialog.close(); });
            dialog.addEventListener('click', function (e) { if (e.target === dialog) { dialog.close(); } });
        })();
    </script>
}
